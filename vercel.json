{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ],
  "redirects": [
    { "source": "/preview", "destination": "/", "permanent": false },
    { "source": "/preview/(.*)", "destination": "/$1", "permanent": false }
  ]
}
